# OpenHIM
OPENHIM_API_URL=https://openhim-api.dev.example.com
OPENHIM_API_USER=root@openhim.org
OPENHIM_API_PASSWORD=changeme
OPENHIM_TRUST_SELF_SIGNED=false

# Mediator
MEDIATOR_PORT=8002
MEDIATOR_URN=urn:mediator:climate-sync
MEDIATOR_HOST=climate.dev.example.com
MEDIATOR_SCHEME=https

# DHIS2
DHIS2_TARGET_URL=https://dhis2.example.com
DHIS2_TARGET_PAT=d2pat_xxxxxxxxxxxxx

# Copernicus CDS API
CDS_API_KEY=your-cds-api-key
CDS_API_URL=https://cds.climate.copernicus.eu/api

# HAPI FHIR
HAPI_FHIR_URL=https://fhir.dev.example.com/fhir
OU_IDENTIFIER_SYSTEM=urn:dhis2:entrepot:organisationUnits
# Prefix for HAPI Location IDs (<prefix>-<orgUnitUID>), avoids clashing with other mediators
LOCATION_ID_PREFIX=entrepot

# Mapping
MAPPING_FILE=mapping.json

# Workers
MAX_WORKERS=5

# Number of past months processed when no year/month/months param is given (1 = previous month)
DEFAULT_MONTHS=1
